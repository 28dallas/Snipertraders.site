# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# M-Pesa Daraja API
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# Deriv API / affiliate attribution (values are safe to expose in the browser)
# Register NEXT_PUBLIC_SITE_URL/auth/deriv/callback as the OAuth redirect URL in Deriv.
NEXT_PUBLIC_DERIV_APP_ID=your_deriv_app_id
NEXT_PUBLIC_DERIV_AFFILIATE_TOKEN=FA33FFDD-3AFC-47A5-BDD5-E838068CEE7A
NEXT_PUBLIC_DERIV_CAMPAIGN=dynamicworks
NEXT_PUBLIC_DERIV_AFFILIATE_LINK=https://deriv.partners/rx?sidc=FA33FFDD-3AFC-47A5-BDD5-E838068CEE7A&utm_campaign=dynamicworks&utm_medium=affiliate&utm_source=CU334550
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/TRENDIF
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/254107646264

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set false in production to require authenticated access to dashboard routes.
NEXT_PUBLIC_PREVIEW_MODE=true

# Required to accept Deriv webhook requests.
DERIV_WEBHOOK_SECRET=replace_with_a_long_random_secret
DERIV_SESSION_SECRET=replace_with_a_different_long_random_secret
